Algoritmo CalcularSumayProducto
	Definir num1,num2,num3,num4,suma,producto Como Real;
	
	Escribir 'ingrese el primer numero:';
	Leer num1;
	Escribir 'ingrese el segundo numero:';
	Leer num2;
	Escribir 'ingrese el tercer numero:';
	Leer num3;
	Escribir 'ingrese el cuarto numero:';
	Leer num4;
	
	suma<-num1+num2;
	producto<-num3*num4;
	
	Escribir 'la suma de los dos primeros numeros es:', suma;
	Escribir 'el producto del tercer y cuarto numero es:', producto;
FinAlgoritmo
